{
  "name": "shopcart-backend",
  "version": "1.0.0",
  "description": "ShopCart E-Commerce Backend API",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:schema": "node src/db/runSchema.js",
    "db:seed": "node src/db/runSeed.js",
    "db:reset": "node src/db/runSchema.js && node src/db/runSeed.js",
    "db:setup": "node src/db/setup.js",
    "test": "cross-env NODE_ENV=test jest"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "jest": "^29.7.0",
    "supertest": "^7.2.2"
  }
}
